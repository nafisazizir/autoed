{
  "name": "autoed",
  "version": "0.1.0",
  "description": "Local agent automations for macOS: schedule and trigger Claude Code / Devin CLI runs on an always-on Mac.",
  "private": true,
  "type": "module",
  "bin": {
    "autoed": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run build:ui && bun --watch src/index.ts serve",
    "start": "bun run build:ui && bun src/index.ts serve",
    "build:ui": "vite build ui",
    "build": "bun run build:ui && bun scripts/build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "doctor": "bun src/index.ts doctor"
  },
  "dependencies": {
    "croner": "^10.0.1",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@nafisazizir/ziiz": "^0.1.0",
    "@tabler/icons-react": "^3.48.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.0"
  },
  "engines": {
    "bun": ">=1.1"
  }
}
